# Resend API key for contact form email delivery
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxx

# Sender address (must be on a verified domain in Resend)
# Format: either "email@domain.com" or "Display Name <email@domain.com>"
CONTACT_FROM_EMAIL=D2Infinite Contact Form <no-reply@d2infinite.com>

# Recipient(s). Comma-separated for multiple inboxes.
CONTACT_TO_EMAIL=contact@d2infinite.com
